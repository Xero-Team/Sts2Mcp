<Project>

  <!--
    Test harnesses are standalone console programs, not shipped code.

    They compile production sources together with test-only stubs (fake game types, fake
    Roslyn shapes, fake reward sessions), so the repository analyzer gate reports the
    stubs and the harness's own top-level statements rather than the code under test.
    Running the gate on them would either force `#pragma` into the stubs or force the
    stubs to look like production code.

    So tests/ imports the repository settings but turns the gate off: warnings are
    reported, never fatal. The gate itself still runs on Sts2Mcp.csproj, which is the
    project that ships. This file is what makes `dotnet build tests/<name>` a quick,
    game-free check instead of a strict-build exercise.
  -->

  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.targets', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <RunAnalyzersDuringBuild>false</RunAnalyzersDuringBuild>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <CodeAnalysisTreatWarningsAsErrors>false</CodeAnalysisTreatWarningsAsErrors>
  </PropertyGroup>

</Project>
