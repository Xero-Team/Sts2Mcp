<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- STS2GameDir / STS2GameDataDir come from Directory.Build.props: no path here. -->
    <Compile Include="../../McpMod.MapDrawingCoordinates.cs" Link="McpMod.MapDrawingCoordinates.cs" />
    <Reference Include="GodotSharp">
      <HintPath>$(STS2GameDataDir)/GodotSharp.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
</Project>
